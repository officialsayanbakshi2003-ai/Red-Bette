# ===== REQUIRED =====
# PostgreSQL connection string (Neon, Supabase, Railway, RDS or local Docker).
DATABASE_URL="postgresql://redbetta:redbetta@localhost:5432/redbetta?schema=public"

# Secret used to sign login sessions. Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# Public URL of the store, no trailing slash (used in emails, SEO and sitemaps).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ===== PAYMENTS (RAZORPAY) =====
# Dashboard → Account & Settings → API Keys. Use rzp_test_ keys until you go live.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Webhooks. Point it at https://YOUR-DOMAIN/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# Local development only: simulate payments when Razorpay keys are empty.
# Ignored in production builds.
ALLOW_DEMO_PAYMENTS="true"

# ===== FIRST ADMIN ACCOUNT (used by `npm run db:seed`) =====
ADMIN_EMAIL="admin@redbetta.in"
ADMIN_PASSWORD=""

# ===== OPTIONAL =====
# Transactional email via https://resend.com (order confirmations, shipping updates).
RESEND_API_KEY=""
EMAIL_FROM="Red Betta <orders@redbetta.in>"

# Product image uploads on Vercel: create a Blob store and paste its token.
# Without it, uploads are saved to UPLOAD_DIR on the server's disk.
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./uploads"

# Protects /api/cron/expire-orders (Vercel Cron sends it automatically).
CRON_SECRET=""
